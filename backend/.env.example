# Cadence Backend Configuration (.env.example)

# Environment and sign-in
# "development" (default) or "production". Production refuses to start without a
# JWT_SECRET of at least 32 characters, disables the shared dev tokens and the demo
# seed endpoint, and never simulates caregiver delivery.
CADENCE_ENV="development"
JWT_SECRET=""
JWT_DEVICE_TTL_DAYS=30
JWT_ACCESS_TTL_MINUTES=720
# Applies only to the two reserved public-demo judging accounts, including old JWTs.
DEMO_ACCOUNTS_EXPIRE_AT_UTC="2026-11-18T08:00:00Z"
# Static tokens require your own nonempty values; account sign-in is preferred.
# Demo mode defaults on in development and off in production.
# ALLOW_STATIC_TOKENS=false
# DEMO_MODE=false

# Role-Based Bearer Tokens & Patient Binding (development only unless ALLOW_STATIC_TOKENS=true)
CADENCE_DEVICE_TOKEN=""
CADENCE_CLINICIAN_TOKEN=""
CADENCE_DEFAULT_PATIENT_ID="default_patient"

# SQLite & Encryption at Rest
# Default is backend/cadence_clinical.db, independent of the working directory.
# SQLITE_DB_PATH="/absolute/path/to/cadence.sqlite"
INFERENCE_REQUESTS_PER_MINUTE=30
SQLITE_ENCRYPTION_KEY=""
RETENTION_DAYS=30
RETENTION_INCIDENT_DAYS=365

# Fireworks AI ($100 Credits)
FIREWORKS_API_KEY=""
FIREWORKS_API_BASE_URL="https://api.fireworks.ai/inference/v1"
FIREWORKS_LLM_MODEL="accounts/fireworks/models/llama-v3p3-70b-instruct"
FIREWORKS_VLM_MODEL="accounts/fireworks/models/llama-v3p2-11b-vision-instruct"

# Meta Model API ($150 Hackathon Credits)
META_API_KEY=""
META_API_BASE_URL="https://api.meta.ai/v1"
META_SAM_MODEL="sam-3.1"
META_STT_MODEL="muse-voice-transcribe-1.0"
META_ASR_BASE_URL="https://api.meta.ai/v1"

# Baseten API ($100 Credits • 2M TPM)
BASETEN_API_KEY=""
BASETEN_API_BASE_URL="https://inference.baseten.co/v1"
BASETEN_MODEL="meta-models/muse-spark-open-1026"

# Interactive request budgets (seconds). A live SAM 3.1 call measured 1-3.6 s.
INTERACTIVE_REQUEST_BUDGET_SEC=12.0
SAM_STAGE_BUDGET_SEC=6.0
SCENE_PROPOSAL_BUDGET_SEC=7.0

# Twilio Caregiver Escalation & Signed Webhooks
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_FROM_PHONE=""
CAREGIVER_PRIMARY_PHONE=""
CAREGIVER_SECONDARY_PHONE=""
PUBLIC_WEBHOOK_BASE_URL="http://localhost:8000"
ENABLE_UNWORN_DROP_SUPPRESSION=false

# Accessibility output is the default. Legacy experimental metrics are outside submission scope.
ENABLE_RESEARCH_METRICS=false
