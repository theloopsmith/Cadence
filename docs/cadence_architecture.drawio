        <mxCell id="c2" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Cadence — current system overview&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#475569&quot;&gt;Swift owns immediate assistance and confirmations. FastAPI owns bounded Meta inference, persistence and reports. Public caregiver delivery is simulated.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry" />
        </mxCell>
