        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br/&gt;MWDATInputs capture-button short press → same photo review flow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
          <mxGeometry x="15" y="265" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Wear state&lt;/b&gt;&lt;br/&gt;donned / doffed → fall check-in context" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
          <mxGeometry x="15" y="335" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Phone motion is the fallback when glasses motion is unavailable. MockGlassesDevice replays labelled IMU loops for the mock kit (-cadence-mock-kit). Physical acceptance on real glasses is still pending." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
          <mxGeometry x="15" y="400" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;Views&lt;/b&gt;&lt;br/&gt;Today · My routine · Settings. Protection on/off is first. Diary opens from Today; glasses/audio details expand. Help has reserved scroll space. Developer tools stay under the Settings toggle." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4">
          <mxGeometry x="15" y="45" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Companion&lt;/b&gt;&lt;br/&gt;Foreground voice starts by default after OS permission. Context-aware intents, separate confirmations, explicit stop and Hey Meta microphone handoff." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4">
          <mxGeometry x="265" y="45" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;DSP&lt;/b&gt;&lt;br/&gt;FoGDetector (freeze cues), FallDetector (3-stage), HomeMotorExamManager, LiveEdgeEngine, WalkTestRecorder" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4">
