        <mxCell id="c7" value="&lt;b&gt;Motion adapter&lt;/b&gt;&lt;br/&gt;Configured 60 Hz accel/gyro/orientation when available; physical acceptance pending." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
          <mxGeometry x="15" y="45" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Camera&lt;/b&gt;&lt;br/&gt;MWDATCamera live stream + photo capture (JPEG)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
          <mxGeometry x="15" y="115" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Microphone and open-ear speakers&lt;/b&gt;&lt;br/&gt;Bluetooth HFP route; wearer hears prompts, beat and siren" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3">
