<mxfile host="Cadence" modified="2026-10-30T18:00:00Z" agent="scripts" version="24.7.17" type="device"><diagram name="1 System overview" id="1_System_overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Cadence — system overview (October 30, 2026)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Swift owns sensing, audio, check-ins and a durable outbox. FastAPI owns authenticated storage, caregiver dispatch and reports. Every runtime model call is a Meta model; spoken output is the phone&amp;#x27;s own voice.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Ray-Ban Meta glasses (Meta Wearables DAT 1.0.1)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#7C3AED;fontStyle=1;fontSize=14;rounded=1;arcSize=6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="560" as="geometry"/></mxCell><mxCell id="c4" value="iPhone — CadenceCompanion (SwiftUI, iOS 16+)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0369A1;fontStyle=1;fontSize=14;rounded=1;arcSize=6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="520" height="560" as="geometry"/></mxCell><mxCell id="c5" value="Backend — FastAPI + SQLite (Mac on the same Wi-Fi, port 8001)" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#15803D;fontStyle=1;fontSize=14;rounded=1;arcSize=6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="300" height="560" as="geometry"/></mxCell><mxCell id="c6" value="External services" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#475569;fontStyle=1;fontSize=14;rounded=1;arcSize=6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1620" y="90" width="230" height="560" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Motion&lt;/b&gt;&lt;br/&gt;MWDATMotion, 60 Hz accel/gyro/orientation → IMUSample" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="45" width="230" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Camera&lt;/b&gt;&lt;br/&gt;MWDATCamera live stream + photo capture (JPEG)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="115" width="230" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Microphone and open-ear speakers&lt;/b&gt;&lt;br/&gt;Bluetooth HFP route; wearer hears prompts, beat and siren" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="185" width="230" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br/&gt;MWDATInputs capture-button short press → same photo review flow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="265" width="230" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Wear state&lt;/b&gt;&lt;br/&gt;donned / doffed → fall check-in context" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="335" width="230" height="50" as="geometry"/></mxCell><mxCell id="c12" value="Phone motion is the fallback when glasses motion is unavailable. MockGlassesDevice replays labelled IMU loops for the mock kit (-cadence-mock-kit). Physical acceptance on real glasses is still pending." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="15" y="400" width="230" height="140" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Views&lt;/b&gt;&lt;br/&gt;Today · Diary · Help + persistent “I need help”. Developer tab only in debug / -cadence-developer. 72–88 pt targets, GuardedButton debounce + haptics, wellness language lint." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="15" y="45" width="240" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Companion&lt;/b&gt;&lt;br/&gt;VoiceCompanion: opt-in voice routing, allowlisted intents, separate confirmation, Hey Meta handoff" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="265" y="45" width="240" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;DSP&lt;/b&gt;&lt;br/&gt;FoGDetector (freeze cues), FallDetector (3-stage), HomeMotorExamManager, LiveEdgeEngine, WalkTestRecorder" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="15" y="150" width="240" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Emergency&lt;/b&gt;&lt;br/&gt;FallAlertCoordinator: 30 s check-in, siren, contact state, detector re-arm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="265" y="150" width="240" height="85" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Audio&lt;/b&gt;&lt;br/&gt;AudioCueEngine (OS voice, metronome, siren), PromptArbiter, EchoGuard, AudioInputOwnership, SpeechCheckInListener + CloudEar, DualRecognizerCheckIn, AudioRouteManager, BackgroundKeepAlive" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="15" y="245" width="240" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Medication and Diary&lt;/b&gt;&lt;br/&gt;MedicationSchedule, DoseLogModel (+ retraction), reminders, PillPhotoStore, DiaryStore, TaskMetrics, SummaryReport → PDF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="265" y="245" width="240" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Sync&lt;/b&gt;&lt;br/&gt;EventSyncManager: owner- and destination-bound SQLite outbox, data-generation fence, fall rows first. CadenceAPIClient (JWT in Keychain), BackendDiscovery (Bonjour)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="15" y="375" width="240" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Hardware&lt;/b&gt;&lt;br/&gt;GlassesDevice protocol, GlassesSessionManager, DATGlassesDevice (app target), PhoneMotion, LocationProvider, Haptics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="265" y="375" width="240" height="110" as="geometry"/></mxCell><mxCell id="c21" value="Single wearer per installation: profile directory Documents/CadenceDevice/&amp;lt;uuid&amp;gt;/ holds diary, task history, pill photo and the outbox. Local reset is explicit and restart-gated." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c4"><mxGeometry x="15" y="495" width="490" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Routes (app/main.py)&lt;/b&gt;&lt;br/&gt;/auth/login · /events/fog · /events/fall (+/delivery, /cancel) · /medication/dose (+/retract) · /meals/log · /reality-check · /speech/transcribe · /companion/interpret · /exam/complete · /report/neurologist · /webhooks/twilio/* · /dashboard" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c5"><mxGeometry x="15" y="45" width="270" height="130" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Services&lt;/b&gt;&lt;br/&gt;fall_escalation + fall_durability (fall_jobs / fall_attempts ledger, at-least-once, leases), reality_check, companion, plain_language, diary_engine, report_snapshot, motor_exam" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c5"><mxGeometry x="15" y="185" width="270" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br/&gt;meta_models (SAM Responses, Muse transcribe) · sam_output parser · baseten_llm · twilio_client · per-model circuit breakers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c5"><mxGeometry x="15" y="295" width="270" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br/&gt;fall_events, fall_jobs, fall_attempts, fall_clear_jobs, caregiver_alerts, medication_logs, medication_retractions, patient_wipes, motor_exams, reality_checks, users, schema_migrations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c5"><mxGeometry x="15" y="385" width="270" height="95" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Care-team dashboard&lt;/b&gt;&lt;br/&gt;/dashboard: nonce CSP, textContent only, username/password sign-in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c5"><mxGeometry x="15" y="490" width="270" height="55" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Meta Model API&lt;/b&gt;&lt;br/&gt;api.meta.ai/v1&lt;br/&gt;SAM 3.1 via POST /responses&lt;br/&gt;Muse Voice Transcribe via /asr/transcribe" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c6"><mxGeometry x="15" y="45" width="200" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Baseten&lt;/b&gt;&lt;br/&gt;meta-models/muse-spark-open-1026&lt;br/&gt;chat/completions, JSON intent only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c6"><mxGeometry x="15" y="150" width="200" height="75" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Twilio&lt;/b&gt;&lt;br/&gt;SMS + voice call, DTMF gather, signed status webhooks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#BE123C;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c6"><mxGeometry x="15" y="240" width="200" height="65" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Apple on-device&lt;/b&gt;&lt;br/&gt;Speech recognizer (requiresOnDeviceRecognition), AVSpeechSynthesizer voices, CoreMotion, CoreLocation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c6"><mxGeometry x="15" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="c31" value="No Meta text-to-speech exists; replies use the best installed OS voice. Apple Speech is an OS feature, not a model provider." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="c6"><mxGeometry x="15" y="425" width="200" height="110" as="geometry"/></mxCell><mxCell id="c32" value="motion 60 Hz" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="video · photo · shutter" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="worn / not worn" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;verticalAlign=bottom;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="prompts · beat · siren" style="edgeStyle=none;html=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.58;exitDx=0;exitDy=0;entryX=1;entryY=0.58;entryDx=0;entryDy=0;verticalAlign=top;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="JSON + JWT" style="edgeStyle=none;html=1;strokeColor=#0369A1;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="X-Cadence-Data-Generation" style="edgeStyle=none;html=1;strokeColor=#0369A1;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="delivery evidence" style="edgeStyle=none;html=1;strokeColor=#15803D;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=top;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="409 after erase" style="edgeStyle=none;html=1;strokeColor=#15803D;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.62;exitDx=0;exitDy=0;entryX=1;entryY=0.62;entryDx=0;entryDy=0;verticalAlign=top;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="SAM 3.1" style="edgeStyle=none;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.14;exitDx=0;exitDy=0;entryX=0;entryY=0.14;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="Muse transcribe" style="edgeStyle=none;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.22;exitDx=0;exitDy=0;entryX=0;entryY=0.22;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="intent (Muse Spark Open)" style="edgeStyle=none;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.34;exitDx=0;exitDy=0;entryX=0;entryY=0.34;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="SMS + call" style="edgeStyle=none;html=1;strokeColor=#BE123C;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.46;exitDx=0;exitDy=0;entryX=0;entryY=0.46;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="signed callbacks" style="edgeStyle=none;html=1;strokeColor=#BE123C;strokeWidth=2;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.58;exitDx=0;exitDy=0;entryX=1;entryY=0.58;entryDx=0;entryDy=0;verticalAlign=top;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Fall safety path" id="2_Fall_safety_path"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Fall safety path — from impact to caregiver evidence&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Deterministic end to end. No model decides anything here. Distress wins; affirmatives stay provisional; the server owns a second timeout so a dead phone still reaches a caregiver.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;IMU samples&lt;/b&gt;&lt;br/&gt;glasses 60 Hz or phone CoreMotion" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="180" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;FallDetector&lt;/b&gt;&lt;br/&gt;Stage 1 free-fall &amp;lt; 0.45 g → Stage 2 impact &amp;gt; 2.8 g, jerk &amp;gt; 35 g/s → Stage 3 tilt. Saves candidate_check_in_pending to the outbox BEFORE anything else." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;FallAlertCoordinator.beginCheckIn&lt;/b&gt;&lt;br/&gt;screen bright, haptic, mic session prepared THEN prompt spoken: “Are you all right? Tell me how you are, or ask me to call someone.” 30 s window. Walking cues blocked." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="340" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Listeners (both fed from one mic tap, echo-guarded)&lt;/b&gt;&lt;br/&gt;Apple on-device recognizer · CloudEar → POST /speech/transcribe → Muse Voice Transcribe" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="340" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DualRecognizerCheckIn (pure reducer)&lt;/b&gt;&lt;br/&gt;Distress from either source latches and escalates now. A local affirmative cancels only with cloud agreement or cloud absence; cloud alone never cancels. Button cancel is immediate." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="340" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Cancelled&lt;/b&gt;&lt;br/&gt;canceled_false_alarm → detector re-armed, POST /events/fall/{id}/cancel, All-Clear SMS if a caregiver was already contacted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#166534;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="300" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Escalate&lt;/b&gt;&lt;br/&gt;confirmed_waiting_dispatch · siren at 0 dBFS out of the phone speaker (route guard keeps it there) · siren resumes by itself after a call interruption or media reset" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="340" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;EventSyncManager outbox&lt;/b&gt;&lt;br/&gt;fall rows drain first; row bound to owner + destination + data generation; signed-out phone → contactState no_connection (“Use the call buttons”)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="300" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;POST /api/v1/events/fall&lt;/b&gt;&lt;br/&gt;fall_jobs committed with ingestion · fall_attempts row BEFORE the provider call · 503 when nothing could be sent, so the phone keeps the row" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="340" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Twilio&lt;/b&gt;&lt;br/&gt;SMS + voice call with DTMF “press 1” · at least once · lease-fenced retries up to the deadline" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#BE123C;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="260" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Signed callbacks&lt;/b&gt;&lt;br/&gt;/webhooks/twilio/gather and /status must match a committed attempt and call SID" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#BE123C;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="630" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Delivery evidence (GET /events/fall/{id}/delivery)&lt;/b&gt;&lt;br/&gt;queued → provider_accepted (real SID) → acknowledged (correlated DTMF). simulated SIDs count as neither. Phone polls while dispatched; SOS and Diary show exactly this." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="340" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Server-owned timeout&lt;/b&gt;&lt;br/&gt;fall_check_in_sec = 45 s (phone window 30 s + upload grace). If the phone never reports, due_jobs promotes the candidate and recover_due_once dispatches at the wearer&amp;#x27;s CURRENT data generation; one failing job cannot stop the sweep." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="190" height="230" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Stage 3 confirmed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="transcripts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="affirmative agreed / button" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#166534;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="distress, or 30 s silence / groan level" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B91C1C;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="drain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="contactState" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="candidate row is already on the server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="promote + dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Audio and echo rules: anything the phone plays (speech, beat, siren) is inside the echo window plus 0.8 s and is dropped from transcripts and voice-level checks. Prompts contain no trigger words. Only one microphone owner at a time; an exam voice step is cancelled when a check-in starts." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="320" height="130" as="geometry"/></mxCell><mxCell id="c31" value="Still unverified: a real Twilio account (Trial sender/recipient setup), physical glasses mic/speaker route, locked-screen continuity." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="240" width="320" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Meta model calls" id="3_Meta_model_calls"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Meta model calls — what each model does and what it may not do&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Models see bounded inputs and return bounded outputs. The phone speaks fixed templates in its own voice.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Check Surroundings&lt;/b&gt;&lt;br/&gt;glasses photo (JPEG, ≤10 MB base64) + wearer&amp;#x27;s question" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;POST /api/v1/reality-check&lt;/b&gt;&lt;br/&gt;reality_check_concepts(question): person, dog, cat + objects the wearer named (default chair, coat); ≤6" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;SAM 3.1 — POST api.meta.ai/v1/responses&lt;/b&gt;&lt;br/&gt;one noun phrase per request, run in parallel under a 6 s stage / 8 s request budget; input_image as data URL; metadata include_confidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="320" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;sam_output parser&lt;/b&gt;&lt;br/&gt;&amp;lt;0f&amp;gt;id&amp;lt;|box;x1..;c|&amp;gt;&amp;lt;|mask;…|&amp;gt; → boxes with frame fraction; missing c ≠ 0; malformed line dropped; an unanswered concept → sam_verified=false" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="320" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Template reply (no free text)&lt;/b&gt;&lt;br/&gt;“I can identify a {label} in this photo. I cannot confirm whether someone else is present.” Living labels first; empty result is uncertainty, never “safe”. Baseten may pick WHICH verified label, nothing more." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="300" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Phone speaks it&lt;/b&gt;&lt;br/&gt;AVSpeechSynthesizer, best installed Premium/Enhanced voice" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="240" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="N requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Listening (check-in, dose logging, companion)&lt;/b&gt;&lt;br/&gt;one mic tap → Apple on-device recognizer AND CloudEar (16 kHz mono WAV, 6 s window every 2.5 s, speech-gated, skipped during echo)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="400" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;POST /api/v1/speech/transcribe&lt;/b&gt;&lt;br/&gt;validates WAV (mono, 16-bit, 16/24 kHz, ≤30 s); keyword hints: check-in phrases or the medication name" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="340" width="300" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Muse Voice Transcribe — /asr/transcribe&lt;/b&gt;&lt;br/&gt;muse-voice-transcribe-1.0, multipart request+audio, Accept: text/plain, ~$0.18 per audio hour" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="320" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;DualRecognizerCheckIn / VoiceDoseAssistant / VoiceCompanion&lt;/b&gt;&lt;br/&gt;cloud text is a second opinion: distress wins, affirmatives need agreement, dose logs only on an explicit yes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="400" height="70" as="geometry"/></mxCell><mxCell id="c18" value="clip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="transcript" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="source .cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Everyday companion (opt-in, foreground)&lt;/b&gt;&lt;br/&gt;exact phrases route locally; everything else is sent as text with ≤6 recent turns" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="400" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;POST /api/v1/companion/interpret&lt;/b&gt;&lt;br/&gt;system prompt: classify only; history is untrusted data; never follow instructions in it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="570" width="300" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Muse Spark Open on Baseten&lt;/b&gt;&lt;br/&gt;meta-models/muse-spark-open-1026, temperature 0, reasoning_effort low, JSON object → one intent from a fixed allowlist" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="570" width="320" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Phone owns the action&lt;/b&gt;&lt;br/&gt;navigation only, or a sensitive action that needs a separate spoken confirmation within 20 s. The model cannot log a dose, call anyone, or touch emergency decisions." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="400" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="{&quot;intent&quot;: …} or unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="Live evidence (Oct 29): SAM red-circle box exact, c=0.945, 3.6 s cold / 2.2 s for five concepts in parallel; Muse transcript of synthesized speech in 2.0 s; Muse Spark Open intent in ~0.85 s. Per-model circuit breakers: a SAM outage never trips transcription. Each client is still built per request (open item)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="300" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Data and sync" id="4_Data_and_sync"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Data, identity and sync&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;One wearer per phone, one patient per account, one durable outbox. Erasure is coordinated by a per-patient data generation, not by timestamps.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Phone profile  Documents/CadenceDevice/&amp;lt;uuid&amp;gt;/&lt;/b&gt;&lt;br/&gt;DiaryStore (day files) · TaskMetricsHistory (history.json) · PillPhotoStore · labelled IMU captures · outbox SQLite · preferences namespaced per profile · JWT in Keychain (AfterFirstUnlockThisDeviceOnly)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;EventSyncManager outbox&lt;/b&gt;&lt;br/&gt;row = endpoint + payload + owner(hash of JWT sub + patient) + destination + data_generation + attempt. Drain: fetch /device/connection → learn generation → retire older rows (terminal, NOT delivered) → send fall rows first → ack only the exact payload revision. 401/403 → onUnauthorized, row kept." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="420" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br/&gt;POST /auth/login (scrypt, 5-strike lockout) → HS256 JWT: device_writer 30 days, clinician_reader 12 h. Production refuses to start without JWT_SECRET ≥32 chars, Twilio + caregiver settings, https webhook, and with demo/static tokens on." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="420" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Write boundary&lt;/b&gt;&lt;br/&gt;every insert runs under BEGIN IMMEDIATE with require_data_generation(patient, header). A wipe deletes + appends patient_wipes in the same transaction → a write either commits before the wipe or gets 409 data_generation_changed. Server recovery writes at the current generation." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="420" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Dose Undo&lt;/b&gt;&lt;br/&gt;medication_retractions: idempotent tombstone referencing the dose UUID; order-independent, replay-safe, patient-scoped. Effective history = doses − retractions on both sides." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="420" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Report&lt;/b&gt;&lt;br/&gt;report_snapshot: one consistent snapshot, exact trailing 24 h [start,end) UTC, every row counted, detail arrays capped at 100 and say so, “No observations” for empty buckets, plain-language narrative (plain_language.summarize_day, no scores)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="480" width="420" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Care-team dashboard&lt;/b&gt;&lt;br/&gt;served by FastAPI with per-response nonce CSP; all text via textContent; carries the loaded generation on mutations; token in sessionStorage only." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="420" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Input validation (models.py)&lt;/b&gt;&lt;br/&gt;CadenceModel: allow_inf_nan=false · UtcTimestamp: ISO-8601, zone-less = UTC, future beyond 5 min rejected · lat/lon bounds · max_length on text, images (10 MB), mask lists." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="420" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Shared PDF summary (phone)&lt;/b&gt;&lt;br/&gt;SummaryReport → CoreText PDF, US Letter, footer disclaimer. Counts only; “Alerts requested”, never “contacted” without server evidence. Range 1 / 7 / 30 days by calendar day." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="420" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Retention&lt;/b&gt;&lt;br/&gt;purge_expired_telemetry at startup and daily from the recovery loop; RETENTION_DAYS (30) for telemetry, incident rows kept (365-day incident purge not yet implemented)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="420" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="X-Cadence-Data-Generation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="422 first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="Boundaries: a server erase leaves phone-local history intact; a local reset leaves server rows intact. Automated caregiver contacts are server-wide settings (single-wearer deployment); the phone&amp;#x27;s numbers only drive its own call buttons." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="320" height="130" as="geometry"/></mxCell><mxCell id="c22" value="CI (.github/workflows/ci.yml): backend pytest from the lockfile, dashboard renderer checks, Playwright browser check with a generated fixture, Swift package tests with silent audio, and an app-target compile with the DAT SDK on an Xcode 16 runner." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;fontColor=#0F172A;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="320" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
