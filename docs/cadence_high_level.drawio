        <!-- ==================== TITLE BANNER ==================== -->
        <mxCell id="title" value="CADENCE — High-Level Animated System Architecture (v1 • &quot;Build for Your World&quot;)&#xa;Zero-Overlap Flow  •  On-Device Metronome Cueing  •  Signed Twilio Escalation + Phone Speaker Siren  •  Guided Home Motor Exam &amp; ON/OFF Diary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#F8FAFC;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
