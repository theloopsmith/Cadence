        </mxCell>

        <!-- ==================== STAGE HEADERS (5 COLUMNS) ==================== -->
        <mxCell id="h_col1" value="STAGE 1: WEARABLE &amp; BODY INPUTS&#xa;Meta Gen 3 Glasses + Simulator / Phone IMU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
