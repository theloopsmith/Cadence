        </mxCell>

        <mxCell id="h_col3" value="STAGE 3: EDGE ACTION / FASTAPI GATEWAY&#xa;Local Cueing or Sync SQLite + 4.0s Deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748B;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
