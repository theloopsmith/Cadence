        <mxCell id="r1_c2" value="⚡ Armed FoG FFT Detector (Edge)&#xa;Walk (3s), Sit-to-Stand, or Yaw-Turn Arm&#xa;Hz-Derived Bins; Speech = +0.8 FI Mod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
