        <!-- ==================== ROW 1 (Y=160): FREEZING OF GAIT ==================== -->
        <mxCell id="r1_c1" value="🦿 6-Axis IMU (Uniform Resampled)&#xa;Linearly resampled at f_s; N &gt;= 2.56*f_s&#xa;(Gen 3 IMU / Phone / Synthetic Injector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#0F172A;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
